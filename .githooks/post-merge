#!/bin/sh
# post-merge: restore execute bits on all shell scripts after a merge/pull.
# Prevents git pull from stripping +x when git has 100644 stored (e.g. after
# a bridge sync commit that forgot to update-index --chmod=+x).
find "$(git rev-parse --show-toplevel)" -name "*.sh" -exec chmod +x {} \;
echo "[post-merge] Restored +x on all .sh files."
