#!/bin/bash
# pre-commit: enforce execute bit on all .sh files tracked in git.
# Prevents bridge syncs from stripping +x from auto_publish.sh etc.

set -e
FIXED=0

# Fix any .sh file tracked in git that lacks execute bit
git ls-files '*.sh' | while read -r f; do
  [ -z "$f" ] && continue
  mode=$(git ls-files -s -- "$f" | awk '{print $1}')
  if [ "$mode" = "100644" ]; then
    git update-index --chmod=+x "$f"
    echo "[pre-commit] chmod +x: $f"
  fi
done

# Warn if layout files staged alongside pipeline/content (non-blocking)
LAYOUT_COUNT=$(git diff --cached --name-only 2>/dev/null | grep -cE "^layouts/|^themes/.+/layouts/" || true)
CONTENT_COUNT=$(git diff --cached --name-only 2>/dev/null | grep -cE "^content/|^pipeline/" || true)
if [ "${LAYOUT_COUNT:-0}" -gt 0 ] && [ "${CONTENT_COUNT:-0}" -gt 0 ]; then
  echo "[pre-commit] WARNING: ${LAYOUT_COUNT} layout file(s) staged with pipeline/content — verify this is intentional."
fi

exit 0
