# Uutistenlukija Pipeline — Environment Variables
# Copy to .env and fill in actual values. NEVER commit .env to git.

# ── OpenAI (required) ──────────────────────────────────────
OPENAI_API_KEY=

# ── Image APIs ─────────────────────────────────────────────
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=

# ── Discord Notifications ──────────────────────────────────
DISCORD_PIPELINE_WEBHOOK=

# ── Ghost CMS (optional — dual-publish) ────────────────────
# Set GHOST_ENABLED=true to publish to Ghost alongside Hugo.
# Ghost failure never blocks Hugo pipeline.
GHOST_ENABLED=false
GHOST_API_URL=https://cms.uutistenlukija.fi
GHOST_ADMIN_API_KEY=

# ── Newsletter signup (Cloudflare Pages worker) ────────────
# Configure these as Cloudflare Pages environment variables for the live
# /api/subscribe endpoint. Do not commit real secrets.
RESEND_API_KEY=
RESEND_AUDIENCE_ID=
# Optional override for testing against a proxy/mock.
RESEND_API_BASE_URL=
