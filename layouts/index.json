[
{{ $pages := where .Site.RegularPages "Section" "posts" }}
{{ range $i, $p := $pages }}
{{ if $i }},{{ end }}
{
  "title": {{ $p.Title | jsonify }},
  "url": {{ $p.Permalink | jsonify }},
  "content": {{ $p.Plain | truncate 300 | jsonify }},
  "date": {{ $p.Date.Format "2.1.2006" | jsonify }},
  "category": {{ with $p.Params.categories }}{{ index . 0 | jsonify }}{{ else }}""{{ end }},
  "author": {{ $p.Params.author | default "" | jsonify }}
}
{{ end }}
]
