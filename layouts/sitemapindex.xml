{{- printf "<?xml version=\"1.0\" encoding=\"UTF-8\"?>" | safeHTML }}
<sitemapindex xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {{- range .Data.Sitemaps }}
  <sitemap>
    <loc>{{ .Permalink }}</loc>
    {{- if not .LastMod.IsZero }}
    <lastmod>{{ .LastMod.Format "2006-01-02T15:04:05-07:00" }}</lastmod>
    {{- end }}
  </sitemap>
  {{- end }}
</sitemapindex>
