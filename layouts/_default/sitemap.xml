{{- printf "<?xml version=\"1.0\" encoding=\"UTF-8\"?>" | safeHTML }}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:image="http://www.google.com/schemas/sitemap-image/1.1"
        xmlns:news="http://www.google.com/schemas/sitemap-news/0.9">
  {{- range .Data.Pages }}
  {{- if and (ne .Permalink "") (ne .Params.noindex true) }}
  {{- $changefreq := "monthly" }}
  {{- $priority   := "0.6" }}
  {{- if .IsHome }}
    {{- $changefreq = "daily" }}
    {{- $priority   = "1.0" }}
  {{- else if eq .Kind "section" }}
    {{- $changefreq = "weekly" }}
    {{- $priority   = "0.8" }}
  {{- else if eq .Kind "taxonomy" }}
    {{- $changefreq = "weekly" }}
    {{- $priority   = "0.7" }}
  {{- else if eq .Kind "term" }}
    {{- $changefreq = "weekly" }}
    {{- $priority   = "0.7" }}
  {{- end }}
  <url>
    <loc>{{ .Permalink }}</loc>
    {{- if not .Lastmod.IsZero }}
    <lastmod>{{ .Lastmod.Format "2006-01-02T15:04:05-07:00" }}</lastmod>
    {{- else if not .Date.IsZero }}
    <lastmod>{{ .Date.Format "2006-01-02T15:04:05-07:00" }}</lastmod>
    {{- end }}
    <changefreq>{{ $changefreq }}</changefreq>
    <priority>{{ $priority }}</priority>
    {{- if .Params.images }}
    {{- range .Params.images }}
    <image:image>
      <image:loc>{{ . }}</image:loc>
      {{- if $.Params.image_alt }}
      <image:title>{{ $.Params.image_alt }}</image:title>
      {{- end }}
    </image:image>
    {{- end }}
    {{- end }}
    {{- if and (eq .Section "posts") (not .Date.IsZero) }}
    <news:news>
      <news:publication>
        <news:name>Uutistenlukija</news:name>
        <news:language>fi</news:language>
      </news:publication>
      <news:publication_date>{{ .Date.Format "2006-01-02T15:04:05-07:00" }}</news:publication_date>
      <news:title>{{ .Title }}</news:title>
      {{- with .Params.categories }}
      {{- range . }}
      <news:keywords>{{ . }}</news:keywords>
      {{- end }}
      {{- end }}
    </news:news>
    {{- end }}
  </url>
  {{- end }}
  {{- end }}
</urlset>
