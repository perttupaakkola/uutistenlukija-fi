# Ghost CMS — Environment Variables
# Copy to .env and fill in actual values
# NEVER commit .env to git

# ── Domain ──────────────────────────────────────────────────
GHOST_DOMAIN=cms.uutistenlukija.fi
CERTBOT_EMAIL=admin@uutistenlukija.fi

# ── MySQL ───────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=
MYSQL_GHOST_PASSWORD=

# ── Mailgun EU (mg.uutistenlukija.fi) ──────────────────────
MAILGUN_SMTP_HOST=smtp.eu.mailgun.org
MAILGUN_SMTP_USER=
MAILGUN_SMTP_PASSWORD=
MAIL_FROM=noreply@uutistenlukija.fi

# ── Stripe (Phase 1b — when Perttu provides) ───────────────
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
